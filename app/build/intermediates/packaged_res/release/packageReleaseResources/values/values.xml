<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <color name="black">#FF000000</color>
    <color name="customCard">#363636</color>
    <color name="customDarkBackground">#2C2C2C</color>
    <color name="customSurfaceDarker">#1E1E1E</color>
    <color name="customSurfaceElevated">#424242</color>
    <color name="editTextHintColor">#8D8D8D</color>
    <color name="lichess_board_dark">#BD5E38</color>
    <color name="lichess_board_light">#F6E1CE</color>
    <color name="lichess_check_square">#E53935</color>
    <color name="lichess_coordinate_dark">#F6E1CE</color>
    <color name="lichess_coordinate_light">#BD5E38</color>
    <color name="lichess_last_move_dark">#68A334</color>
    <color name="lichess_last_move_light">#85C246</color>
    <color name="lichess_legal_move_dot">#66000000</color>
    <color name="lichess_selected_square">#78B83D</color>
    <color name="lichess_selected_square_dark">#6DA937</color>
    <color name="lichess_selected_square_light">#8CC64B</color>
    <color name="orangeAccent">#FF5722</color>
    <color name="primaryOrange">#E64A19</color>
    <color name="primaryOrangeDark">#D84315</color>
    <color name="primaryOrangeLight">#FF7043</color>
    <color name="status_amber">#FFC107</color>
    <color name="status_green">#4CAF50</color>
    <color name="status_red">#F44336</color>
    <color name="textPrimary">#FFFFFF</color>
    <color name="textSecondary">#BDBDBD</color>
    <color name="white">#FFFFFFFF</color>
    <string name="app_name">GambitStudio</string>
    <string name="piece_bishop">Bishop</string>
    <string name="piece_knight">Knight</string>
    <string name="piece_queen">Queen</string>
    <string name="piece_rook">Rook</string>
    <string name="promotion_title">Promote Pawn</string>
    <style name="CustomBottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>
    <style name="CustomBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/customCard</item>
        <item name="shapeAppearance">@style/ShapeAppearance.RoundedTop</item>
    </style>
    <style name="CustomMaterialAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/customCard</item>
        <item name="colorOnSurface">@color/textPrimary</item>
    </style>
    <style name="ShapeAppearance.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeAppearance.RoundedTop" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="Theme.GambitStudio" parent="Theme.Material3.Dark.NoActionBar">
        
        <item name="colorPrimary">@color/primaryOrange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primaryOrangeDark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/orangeAccent</item>
        <item name="colorOnSecondary">@color/white</item>

        
        <item name="android:windowBackground">@color/customDarkBackground</item>
        <item name="colorSurface">@color/customCard</item>
        <item name="colorOnSurface">@color/textPrimary</item>
        <item name="colorSurfaceVariant">@color/customSurfaceElevated</item>
        <item name="colorOnSurfaceVariant">@color/textSecondary</item>

        
        <item name="android:statusBarColor">@color/customDarkBackground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/customDarkBackground</item>
        <item name="android:windowLightNavigationBar" ns1:targetApi="o_mr1">false</item>

        
        <item name="bottomSheetDialogTheme">@style/CustomBottomSheetDialogTheme</item>
        <item name="materialAlertDialogTheme">@style/CustomMaterialAlertDialogTheme</item>
    </style>
</resources>